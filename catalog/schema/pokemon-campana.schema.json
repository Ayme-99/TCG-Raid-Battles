{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pokémon de campaña (D-20)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "numero",
    "nombre",
    "tipo",
    "ps",
    "ataques"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "numero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 151,
      "description": "Número de la Pokédex de Kanto."
    },
    "nombre": {
      "type": "string"
    },
    "tipo": {
      "$ref": "#/$defs/tipo"
    },
    "ps": {
      "type": "integer",
      "minimum": 30,
      "multipleOf": 10,
      "maximum": 340,
      "description": "Escala del TCG real (D-20 §3.5): básico 50–90, Fase 1 90–130, ex 200–340."
    },
    "debilidad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/tipo"
        },
        "multiplicador": {
          "type": "integer",
          "minimum": 2,
          "default": 2
        }
      }
    },
    "resistencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/tipo"
        },
        "reduccion": {
          "type": "integer",
          "minimum": 10,
          "default": 30
        }
      }
    },
    "retirada": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 0
    },
    "ataques": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "tipo",
          "coste",
          "dano"
        ],
        "properties": {
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "$ref": "#/$defs/tipo"
          },
          "coste": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "dano": {
            "type": "integer",
            "minimum": 0,
            "multipleOf": 10,
            "description": "0 solo si el ataque lleva un efecto."
          },
          "efecto": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "valor"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "reduceDanoRival",
                  "aumentaDanoRecibido"
                ],
                "description": "reduceDanoRival: mientras el activo rival siga activo, sus ataques hacen `valor` menos de daño (Gruñido). aumentaDanoRecibido: mientras siga activo, recibe `valor` más de daño de los ataques (Látigo). Ambos, antes de debilidad y resistencia, sin acumular (D-20 §3.6)."
              },
              "valor": {
                "type": "integer",
                "minimum": 10,
                "multipleOf": 10
              },
              "texto": {
                "type": "string",
                "description": "Texto de la carta."
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "efecto"
                ]
              }
            },
            "then": {
              "properties": {
                "dano": {
                  "minimum": 10
                }
              }
            }
          }
        ]
      },
      "contains": {
        "properties": {
          "dano": {
            "minimum": 20
          }
        },
        "required": [
          "dano"
        ]
      },
      "description": "Al menos un ataque de 20 o más de daño, para que Gruñido (−10) nunca anule a la carta (D-20 §3.6)."
    },
    "ex": {
      "type": "boolean",
      "default": false,
      "description": "Carta ex: la última fase de cada Pokémon (D-20 §2.1)."
    },
    "evoluciones": {
      "type": "array",
      "default": [],
      "description": "Cómo evoluciona (D-20 §2.1). La carta evolucionada sustituye a la anterior.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "via"
        ],
        "properties": {
          "a": {
            "type": "string",
            "description": "Id del Pokémon en que evoluciona."
          },
          "via": {
            "enum": [
              "xp",
              "objeto",
              "intercambio",
              "puntos"
            ]
          },
          "xp": {
            "type": "integer",
            "minimum": 10,
            "multipleOf": 10
          },
          "objeto": {
            "type": "string"
          },
          "puntos": {
            "type": "integer",
            "minimum": 10,
            "multipleOf": 10
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "via": {
                  "const": "xp"
                }
              }
            },
            "then": {
              "required": [
                "xp"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "via": {
                  "const": "objeto"
                }
              }
            },
            "then": {
              "required": [
                "objeto"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "via": {
                  "enum": [
                    "intercambio",
                    "puntos"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "puntos"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "tipo": {
      "enum": [
        "normal",
        "fuego",
        "agua",
        "planta",
        "electrico",
        "hielo",
        "lucha",
        "veneno",
        "tierra",
        "volador",
        "psiquico",
        "bicho",
        "roca",
        "fantasma",
        "dragon"
      ]
    }
  }
}
