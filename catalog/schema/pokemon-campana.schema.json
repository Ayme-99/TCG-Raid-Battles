{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pokémon de campaña (D-20)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "numero",
    "nombre",
    "tipo",
    "ps",
    "ataques"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "numero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 151,
      "description": "Número de la Pokédex de Kanto."
    },
    "nombre": {
      "type": "string"
    },
    "tipo": {
      "$ref": "#/$defs/tipo"
    },
    "ps": {
      "type": "integer",
      "minimum": 30,
      "multipleOf": 10,
      "maximum": 340,
      "description": "Escala del TCG real (D-20 §3.5): básico 50–90, Fase 1 90–130, ex 200–340."
    },
    "debilidad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/tipo"
        },
        "multiplicador": {
          "type": "integer",
          "minimum": 2,
          "default": 2
        }
      }
    },
    "resistencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/tipo"
        },
        "reduccion": {
          "type": "integer",
          "minimum": 10,
          "default": 30
        }
      }
    },
    "retirada": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 0
    },
    "ataques": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "tipo",
          "coste",
          "dano"
        ],
        "properties": {
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "$ref": "#/$defs/tipo"
          },
          "coste": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "dano": {
            "type": "integer",
            "minimum": 0,
            "multipleOf": 10,
            "description": "0 solo si el ataque lleva un efecto."
          },
          "efecto": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "reduceDanoRival",
                  "aumentaDanoRecibido",
                  "quitaEnergiaRival",
                  "monedaDanoExtra",
                  "envenenaDefensor",
                  "reduceDanoPropio",
                  "monedaFalloRival",
                  "danoPorRacha",
                  "monedasDano",
                  "repiteDanoAlDerribar"
                ],
                "description": "reduceDanoRival: mientras el activo rival siga activo, sus ataques hacen `valor` menos de daño (Gruñido). aumentaDanoRecibido: mientras siga activo, recibe `valor` más de daño de los ataques (Látigo). Ambos, antes de debilidad y resistencia, sin acumular. quitaEnergiaRival: el rival pierde `valor` de energía (si le queda) al usar el ataque, una sola vez. monedaDanoExtra: lanza una moneda; si sale cara el ataque hace `valor` más de daño (el `dano` de la carta es el de cruz). envenenaDefensor: el activo rival pierde `valor` PS en cada chequeo Pokémon (cada cambio de turno) mientras siga activo, sin acumular. reduceDanoPropio: mientras el propio Pokémon siga activo, recibe `valor` menos de daño de los ataques, antes de debilidad y resistencia, sin acumular. monedaFalloRival (sin `valor`): en su próximo turno, si el rival ataca lanza una moneda y con cruz ese ataque no hace nada, con la energía gastada. danoPorRacha (sin `valor`): el `dano` se multiplica por las veces seguidas que este Pokémon ha usado el ataque, contando la actual. monedasDano: lanza `monedas` monedas y hace `danoPorCaras[n]` con n caras; el `dano` del ataque es el daño esperado, solo para la IA. repiteDanoAlDerribar (sin `valor`): si el ataque derriba al activo rival, el nuevo activo recibe de nuevo ese ataque al salir, una sola vez (D-20 §3.6)."
              },
              "monedas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6,
                "description": "monedasDano: cuántas monedas se lanzan."
              },
              "danoPorCaras": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "multipleOf": 10
                },
                "description": "monedasDano: el daño con 0, 1, 2… caras (monedas + 1 valores)."
              },
              "valor": {
                "type": "integer",
                "minimum": 1,
                "description": "Tamaño del efecto: PS o daño en múltiplos de 10; para quitaEnergiaRival, puntos de energía."
              },
              "texto": {
                "type": "string",
                "description": "Texto de la carta."
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "efecto"
                ]
              }
            },
            "then": {
              "properties": {
                "dano": {
                  "minimum": 10
                }
              }
            }
          }
        ]
      },
      "contains": {
        "anyOf": [
          {
            "properties": {
              "dano": {
                "minimum": 20
              }
            },
            "required": [
              "dano"
            ]
          },
          {
            "properties": {
              "efecto": {
                "properties": {
                  "tipo": {
                    "const": "envenenaDefensor"
                  }
                },
                "required": [
                  "tipo"
                ]
              }
            },
            "required": [
              "efecto"
            ]
          }
        ]
      },
      "description": "Al menos un ataque de 20 o más de daño, o con un efecto de estado (veneno) que Gruñido no anula (D-20 §3.6)."
    },
    "habilidad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "tipo", "valor"],
      "properties": {
        "nombre": { "type": "string" },
        "tipo": { "enum": ["monedaDanoExtraAlAtacar"] },
        "valor": { "type": "integer", "minimum": 1 },
        "texto": { "type": "string" }
      },
      "description": "Habilidad pasiva. monedaDanoExtraAlAtacar: mientras el Pokémon siga activo, cada vez que ataca lanza una moneda y con cara el ataque hace `valor` más de daño (D-20 §3.6)."
    },
    "ex": {
      "type": "boolean",
      "default": false,
      "description": "Carta ex: la última fase de cada Pokémon (D-20 §2.1)."
    },
    "evoluciones": {
      "type": "array",
      "default": [],
      "description": "Cómo evoluciona (D-20 §2.1). La carta evolucionada sustituye a la anterior.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "via"
        ],
        "properties": {
          "a": {
            "type": "string",
            "description": "Id del Pokémon en que evoluciona."
          },
          "via": {
            "enum": [
              "xp",
              "objeto",
              "intercambio",
              "puntos"
            ]
          },
          "xp": {
            "type": "integer",
            "minimum": 10,
            "multipleOf": 10
          },
          "objeto": {
            "type": "string"
          },
          "puntos": {
            "type": "integer",
            "minimum": 10,
            "multipleOf": 10
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "via": {
                  "const": "xp"
                }
              }
            },
            "then": {
              "required": [
                "xp"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "via": {
                  "const": "objeto"
                }
              }
            },
            "then": {
              "required": [
                "objeto"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "via": {
                  "enum": [
                    "intercambio",
                    "puntos"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "puntos"
              ]
            }
          }
        ]
      }
    },
    "ex": {
      "type": "boolean",
      "default": false,
      "description": "Carta ex: la última fase de cada Pokémon (D-20 §2.1)."
    },
    "evoluciones": {
      "type": "array",
      "default": [],
      "description": "Cómo evoluciona (D-20 §2.1). La carta evolucionada sustituye a la anterior.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "via"
        ],
        "properties": {
          "a": {
            "type": "string",
            "description": "Id del Pokémon en que evoluciona."
          },
          "via": {
            "enum": [
              "xp",
              "objeto",
              "intercambio",
              "puntos"
            ]
          },
          "xp": {
            "type": "integer",
            "minimum": 10,
            "multipleOf": 10
          },
          "objeto": {
            "type": "string"
          },
          "puntos": {
            "type": "integer",
            "minimum": 10,
            "multipleOf": 10
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "via": {
                  "const": "xp"
                }
              }
            },
            "then": {
              "required": [
                "xp"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "via": {
                  "const": "objeto"
                }
              }
            },
            "then": {
              "required": [
                "objeto"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "via": {
                  "enum": [
                    "intercambio",
                    "puntos"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "puntos"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "tipo": {
      "enum": [
        "normal",
        "fuego",
        "agua",
        "planta",
        "electrico",
        "hielo",
        "lucha",
        "veneno",
        "volador",
        "psiquico",
        "oscuridad",
        "bicho",
        "fantasma",
        "dragon"
      ]
    }
  }
}
