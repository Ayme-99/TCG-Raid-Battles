{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ayme-99/TCG-Raid-Battles/catalog/schema/boss.schema.json",
  "title": "Jefe del catálogo de Incursiones (formato 1)",
  "description": "Un jefe: carta fija con su HP y sus 3 ataques. Si invoca, declara cada cuántos HP perdidos hay un intento y sus aliados, uno por categoría (D-13, D-16).",
  "type": "object",
  "required": [
    "formato",
    "id",
    "nombre",
    "nivel",
    "hp",
    "ataques"
  ],
  "additionalProperties": false,
  "properties": {
    "formato": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nombre": {
      "type": "string",
      "minLength": 1
    },
    "nivel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "mapa": {
      "description": "Mapa o escenario del jefe (informativo).",
      "type": "string",
      "minLength": 1
    },
    "hp": {
      "type": "integer",
      "minimum": 1
    },
    "ataques": {
      "description": "Los 3 ataques de la carta; la posición es la ranura (1 a 3).",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/ataqueJefe"
      }
    },
    "invocacion": {
      "$ref": "#/$defs/invocacion"
    },
    "imagen": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "ataqueJefe": {
      "type": "object",
      "required": [
        "nombre",
        "dano"
      ],
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1
        },
        "dano": {
          "type": "integer",
          "minimum": 0
        },
        "efecto": {
          "description": "Efecto del ataque (D-14). `tipo` es uno de los tipos del motor (`TipoEfectoAtaque`); `texto` es lo que lee la mesa. `conMoneda`: el ataque lanza moneda (la lanza la app).",
          "type": "object",
          "required": [
            "tipo",
            "texto"
          ],
          "additionalProperties": false,
          "properties": {
            "tipo": {
              "enum": [
                "sinRetirada",
                "sinAtaque",
                "paralizarDefensor",
                "ignoraEfectos",
                "danoExtraSi",
                "danoPorAtaquePrevio",
                "contadorATodos",
                "autodano"
              ]
            },
            "valor": {
              "type": "integer",
              "minimum": 1
            },
            "duracion": {
              "type": "integer",
              "minimum": 1
            },
            "conMoneda": {
              "type": "boolean"
            },
            "texto": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "invocacion": {
      "description": "Un jefe sin este bloque nunca invoca (D-04 §7.1).",
      "type": "object",
      "required": [
        "cadaHp",
        "aliados"
      ],
      "additionalProperties": false,
      "properties": {
        "cadaHp": {
          "description": "Cada cuántos HP perdidos hay un intento de invocación.",
          "type": "integer",
          "minimum": 1
        },
        "tirada": {
          "description": "Cómo se tira el intento. Por defecto, una moneda (cara = invoca). `segura`: sin moneda, cada intento invoca (si hay slot libre).",
          "enum": [
            "moneda",
            "segura"
          ]
        },
        "aliados": {
          "description": "Un aliado por categoría (D-13, D-16). Provisional: hasta que cada jefe tenga sus 6 aliados, potenciador y debilitador son opcionales.",
          "type": "object",
          "required": [
            "danio",
            "tanque",
            "cura",
            "control"
          ],
          "additionalProperties": false,
          "properties": {
            "danio": {
              "$ref": "#/$defs/aliado"
            },
            "tanque": {
              "$ref": "#/$defs/aliado"
            },
            "cura": {
              "$ref": "#/$defs/aliado"
            },
            "control": {
              "$ref": "#/$defs/aliado"
            },
            "potenciador": {
              "$ref": "#/$defs/aliado"
            },
            "debilitador": {
              "$ref": "#/$defs/aliado"
            }
          }
        }
      }
    },
    "aliado": {
      "type": "object",
      "required": [
        "nombre",
        "hp"
      ],
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1
        },
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "ataque": {
          "description": "Ausente: el aliado no ataca (solo habilidad). Con `monedas`, `dano` es el daño por cada cara de esas monedas (como «20×» en una carta); la app tira las monedas y registra el daño final.",
          "type": "object",
          "required": [
            "nombre",
            "dano"
          ],
          "additionalProperties": false,
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "dano": {
              "type": "integer",
              "minimum": 0
            },
            "monedas": {
              "type": "integer",
              "minimum": 1
            },
            "texto": {
              "description": "Efecto del ataque, tal como lo lee la mesa.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "habilidadNombre": {
          "description": "Nombre de la habilidad de la carta.",
          "type": "string",
          "minLength": 1
        },
        "habilidad": {
          "type": "string",
          "minLength": 1
        },
        "efectos": {
          "description": "Quién aplica los efectos de la carta: el jugador (por defecto) o el programa, con el script de scriptId.",
          "enum": [
            "jugador",
            "programa"
          ]
        },
        "scriptId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "if": {
        "required": [
          "efectos"
        ],
        "properties": {
          "efectos": {
            "const": "programa"
          }
        }
      },
      "then": {
        "required": [
          "scriptId"
        ]
      },
      "else": {
        "not": {
          "required": [
            "scriptId"
          ]
        }
      }
    }
  }
}
