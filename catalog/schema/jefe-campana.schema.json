{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jefe de campaña (D-20 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "numero",
    "pokemon"
  ],
  "properties": {
    "numero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Número en la serie de jefes (NN/20): 1–8 de tramo, 9–16 de rutas clave, 17–20 legendarios."
    },
    "pokemon": {
      "$ref": "pokemon-campana.schema.json",
      "description": "La carta del jefe, con el formato de un Pokémon de campaña."
    },
    "llamaAliado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alBajarDePorcentaje",
        "aliados"
      ],
      "description": "Cuando el jefe baja de ese porcentaje de PS se retira a la banca y entra un aliado elegido al azar (semilla del combate); al caer el aliado vuelve el jefe con los PS que tenía.",
      "properties": {
        "alBajarDePorcentaje": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "aliados": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "Ids de Pokémon del catálogo."
        }
      }
    }
  }
}
