{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zona de campaña (D-20)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nombre",
    "region",
    "salvajes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "nombre": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "salvajes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids de los Pokémon que aparecen salvajes. Vacío en una zona sin salvajes (un gimnasio)."
    },
    "entrenadores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clase",
          "pokemon"
        ],
        "properties": {
          "clase": {
            "type": "string"
          },
          "pokemon": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dinero": {
            "type": "integer",
            "minimum": 0,
            "description": "Dinero que paga cada entrenador de la clase al ser vencido (D-20 §10.6): Cazabichos 200, Entrenador Joven 260."
          }
        }
      }
    },
    "jefe": {
      "type": "string",
      "description": "Id del Pokémon jefe de la zona, si lo hay."
    }
  }
}
